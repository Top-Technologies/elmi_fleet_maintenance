<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_elmi" model="ir.ui.view">
        <field name="name">hr.employee.form.elmi</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='departure']" position="before">
                <group string="Tool clearance" name="elmi_tool_clearance">
                    <field name="elmi_tool_clearance_ok"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
